# Copy to `.env` and fill in. Never commit the filled copy.
#
#   cp .env.example .env
#
# 1. Database --------------------------------------------------------------
# SQLite needs no server: the path is relative to the `prisma/` directory.
DATABASE_URL="file:./dev.db"
# PostgreSQL (production) example:
# DATABASE_URL="postgresql://user:password@host:5432/atelier_nord?schema=public"
# and change `provider = "sqlite"` to `provider = "postgresql"` in prisma/schema.prisma

# 2. Authentication --------------------------------------------------------
# Session cookies are signed with this value. Required in production.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-32-bytes-of-random-data"

# 3. Image storage ---------------------------------------------------------
# Uploaded files are written here and served through /media/<key>.
# Use an absolute path on hosts where the project directory is read-only.
UPLOAD_DIR="storage/uploads"
# Maximum size of a single uploaded image, in megabytes.
MAX_UPLOAD_MB="8"

# 4. Site ------------------------------------------------------------------
# Used for absolute URLs in metadata, the sitemap and social share tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Hostnames allowed through the Next.js image optimiser, comma separated.
# Use "*" to allow any https host (only do this if admins paste their own URLs).
IMAGE_REMOTE_HOSTS="images.unsplash.com,cdn.stocksnap.io,upload.wikimedia.org,images.pexels.com,cdn.pixabay.com"

# 5. Initial admin account -------------------------------------------------
# Only read when seeding an empty database or running the create-admin script.
SEED_ADMIN_EMAIL="studio@example.com"
SEED_ADMIN_PASSWORD="change-this-password"
SEED_ADMIN_NAME="Studio Manager"
