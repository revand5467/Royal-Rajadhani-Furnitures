# Copy to `.env` and fill in. Never commit the filled copy.
#
#   cp .env.example .env
#
# 1. Database (PostgreSQL — Supabase) ---------------------------------------
# Prisma runs MIGRATIONS over DIRECT_URL and the APP over DATABASE_URL.
#
#   Supabase dashboard → Project Settings → Database → Connection string:
#     • "Connection pooling" (port 6543)  → DATABASE_URL   (append &pgbouncer=true)
#     • "Direct connection"  (port 5432)  → DIRECT_URL
#   (For plain Postgres with no pooler, set both to the same string.)
#
# Local SQLite alternative: change provider back to "sqlite" in
# prisma/schema.prisma and use DATABASE_URL="file:./dev.db" (DIRECT_URL unused).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# 2. Authentication ---------------------------------------------------------
# Session cookies are signed with this value. Required in production.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-32-bytes-of-random-data"

# 3. Image storage ----------------------------------------------------------
# With the two Supabase values below set, uploads go to Supabase Storage
# (public bucket, served by its CDN) — required on Vercel. Leave them empty to
# store files on local disk under UPLOAD_DIR instead.
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="media"

# Local-disk mode only. Use an absolute path on read-only hosts.
UPLOAD_DIR="storage/uploads"
# Maximum size of a single uploaded image, in megabytes. Keep at 4 on Vercel
# (server actions are capped at ~4.5 MB regardless of the bodySizeLimit below).
MAX_UPLOAD_MB="8"

# 4. Site -------------------------------------------------------------------
# Used for absolute URLs in metadata, the sitemap and social share tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Extra hostnames allowed through the Next.js image optimiser, comma separated.
# The configured Supabase storage host is always allowed automatically.
# Use "*" to allow any https host (only do this if admins paste their own URLs).
IMAGE_REMOTE_HOSTS=""

# 5. Initial admin account --------------------------------------------------
# Only read when seeding an empty database or running the create-admin script.
SEED_ADMIN_EMAIL="studio@example.com"
SEED_ADMIN_PASSWORD="change-this-password"
SEED_ADMIN_NAME="Studio Manager"
