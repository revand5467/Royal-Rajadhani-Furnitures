// Rajadhani Furniture — furniture showcase data model.
//
// PostgreSQL (Supabase) is the deployment default; SQLite still works locally
// by pointing DATABASE_URL at a file and switching the provider back. Enum-like
// columns are plain strings validated with zod so the schema stays portable.

generator client {
  provider = "prisma-client-js"
  // The checkout can be run from Windows, WSL or CI; ship both query engines.
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  // Migrations run over the direct connection (DIRECT_URL); the app uses the
  // pooled one (DATABASE_URL) so serverless functions don't exhaust Postgres
  // connections. With Supabase: DATABASE_URL = pooler host + ?pgbouncer=true,
  // DIRECT_URL = db.<project-ref>.supabase.co:5432. For plain Postgres (no
  // pooler), set both to the same connection string.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  blurb     String?
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

/// Curated, cross-category groupings shown on the homepage and in the catalog.
model Collection {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  blurb     String?
  position  Int       @default(0)
  featured  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  summary          String
  description      String
  priceCents       Int
  currency         String         @default("INR")
  /// Optional discount: "PERCENT" (of priceCents) or "AMOUNT" (fixed, in paise).
  discountType     String?
  discountPercent  Float?
  discountValueCents Int?
  /// priceCents minus the discount, maintained by saveProduct(). Filtering and
  /// sorting in the catalog use this column so queries stay typed Prisma.
  effectivePriceCents Int        @default(0)
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id])
  collectionId     String?
  collection       Collection?    @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  materials        String
  finish           String?
  widthCm          Int?
  depthCm          Int?
  heightCm         Int?
  dimensionNote    String?
  careInstructions String?
  /// IN_STOCK | MADE_TO_ORDER | PRE_ORDER | SOLD_OUT
  availability     String         @default("IN_STOCK")
  sku              String         @unique
  featured         Boolean        @default(false)
  /// DRAFT | PUBLISHED
  status           String         @default("DRAFT")
  publishedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  images           ProductImage[]
  inquiries        Inquiry[]

  @@index([status, featured])
  @@index([categoryId])
  @@index([collectionId])
  @@index([priceCents])
  @@index([effectivePriceCents])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Either an uploaded file served from /media/... or an absolute https URL.
  url       String
  alt       String
  credit    String?
  width     Int?
  height    Int?
  position  Int      @default(0)
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

model Inquiry {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  subject    String?
  message    String
  kind       String   @default("CONTACT")
  /// NEW | READ | RESOLVED
  status     String   @default("NEW")
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  sourcePath String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
}

/// Single-row table (id = "default") holding store details and homepage copy.
model SiteSettings {
  id               String        @id @default("default")
  storeName        String
  tagline          String
  footerBlurb      String
  heroHeadline     String
  heroSubhead      String
  heroImageUrl     String?
  heroImageAlt     String?
  storyHeading     String
  storyBody        String
  storyImageUrl    String?
  storyImageAlt    String?
  visitHeading     String
  visitBody        String
  addressLine1     String
  addressLine2     String?
  city             String
  region           String?
  postalCode       String?
  country          String
  phone            String
  /// Optional: left unset when the shop has not published an email address.
  email            String?
  mapUrl           String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  openingHours     OpeningHour[]
  socialLinks      SocialLink[]
  highlights       Highlight[]
}

model OpeningHour {
  id         String       @id @default(cuid())
  settingsId String
  settings   SiteSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  /// 0 = Sunday … 6 = Saturday
  dayOfWeek  Int
  opens      String?
  closes     String?
  closed     Boolean      @default(false)
  position   Int          @default(0)

  @@unique([settingsId, dayOfWeek])
}

model SocialLink {
  id         String       @id @default(cuid())
  settingsId String
  settings   SiteSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  platform   String
  url        String
  position   Int          @default(0)
}

/// Short "why buy from us" blocks on the homepage.
model Highlight {
  id         String       @id @default(cuid())
  settingsId String
  settings   SiteSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  title      String
  body       String
  position   Int          @default(0)
}
